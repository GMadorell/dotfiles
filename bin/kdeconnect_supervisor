#!/bin/bash
# Keeps KDE Connect alive. Run every 60s by
# ~/Library/LaunchAgents/com.gmadorell.kdeconnect-supervisor.plist
#
# kdeconnectd dies on its own (usually after sleep) and the bundled DBus can't
# re-activate it: https://bugs.kde.org/show_bug.cgi?id=463636
# The app doesn't respawn it either, so recovery means relaunching the bundle.
#
# KDECONNECT_SUPERVISOR_DRY_RUN=1 logs decisions without restarting.

set -uo pipefail

APP="/Applications/KDE Connect.app"
CLI="/opt/homebrew/bin/kdeconnect"
[[ -x "$CLI" ]] || CLI="$APP/Contents/MacOS/kdeconnect-cli"

STATE_DIR="$HOME/.local/state/kdeconnect-supervisor"
LOG="$STATE_DIR/supervisor.log"
STATE="$STATE_DIR/state"
LOG_MAX_BYTES=$((5 * 1024 * 1024))

# Absorbs our own relaunch window, so a probe landing mid-restart isn't a fault.
FAILURES_BEFORE_RESTART=3
RESTART_COOLDOWN_SECONDS=600
# Breaker: stop restarting after this many failed attempts, until healthy again.
MAX_CONSECUTIVE_RESTARTS=3

DRY_RUN="${KDECONNECT_SUPERVISOR_DRY_RUN:-0}"

mkdir -p "$STATE_DIR"

log() {
  printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >>"$LOG"
}

rotate_log() {
  local size
  size=$(stat -f %z "$LOG" 2>/dev/null || echo 0)
  ((size > LOG_MAX_BYTES)) && mv -f "$LOG" "$LOG.1"
}

fail_streak=0
restart_streak=0
last_restart=0
# shellcheck source=/dev/null
[[ -f $STATE ]] && source "$STATE"

save_state() {
  cat >"$STATE" <<EOF
fail_streak=$fail_streak
restart_streak=$restart_streak
last_restart=$last_restart
EOF
}

# Restart triggers: only local faults, the only thing a restart can fix.
probe_daemon() { pgrep -x kdeconnectd >/dev/null 2>&1; }
# Alive but unbound == wedged.
probe_listen() { lsof -nP -iTCP:1716 -sTCP:LISTEN >/dev/null 2>&1; }

# Logged for context, never a trigger: both go 0 whenever the phone is simply
# away, and restarting on that only churns the app (multi-hour outages in the
# logs recovered on their own, after the breaker had stopped restarting).
# kdeconnect-cli always prints a DBus activation error to stderr; judge stdout.
probe_device() { "$CLI" -a --id-name-only 2>/dev/null | grep -q .; }
probe_socket() { lsof -nP -iTCP:1716 -sTCP:ESTABLISHED >/dev/null 2>&1; }

restart_app() {
  osascript -e 'quit app "KDE Connect"' >/dev/null 2>&1
  sleep 3
  pkill -x kdeconnectd
  pkill -x "KDE Connect"
  pkill -f "KDE Connect.app/Contents/MacOS/dbus-daemon"
  sleep 2
  # Must go through LaunchServices: launching kdeconnectd directly gives it the
  # wrong environment and the wrong TCC owner for Local Network.
  # -g plus LSUIElement=1 means it can't take focus.
  open -g -a "$APP"
}

rotate_log

if [[ ! -d $APP ]]; then
  log "action=abort reason=app_missing path=$APP"
  exit 0
fi

probe_daemon && daemon=1 || daemon=0
probe_listen && listen=1 || listen=0
probe_device && device=1 || device=0
probe_socket && socket=1 || socket=0

if ((daemon && listen)); then
  if ((fail_streak || restart_streak)); then
    log "event=recovered after_failures=$fail_streak after_restarts=$restart_streak"
  fi
  fail_streak=0
  restart_streak=0
  log "health=ok daemon=1 listen=1 device=$device socket=$socket fail_streak=0"
  save_state
  exit 0
fi

((fail_streak++))
log "health=bad daemon=$daemon listen=$listen device=$device socket=$socket fail_streak=$fail_streak"

((fail_streak < FAILURES_BEFORE_RESTART)) && { save_state; exit 0; }

if ((restart_streak >= MAX_CONSECUTIVE_RESTARTS)); then
  log "action=skip reason=breaker_open restarts=$restart_streak"
  save_state
  exit 0
fi

now=$(date +%s)
since=$((now - last_restart))
if ((last_restart && since < RESTART_COOLDOWN_SECONDS)); then
  log "action=skip reason=cooldown since_last=${since}s"
  save_state
  exit 0
fi

if [[ $DRY_RUN != 0 ]]; then
  log "action=restart_skipped reason=dry_run daemon=$daemon listen=$listen device=$device socket=$socket"
  fail_streak=0
  save_state
  exit 0
fi

log "action=restart daemon=$daemon listen=$listen device=$device socket=$socket restart_streak=$((restart_streak + 1))"
restart_app
last_restart=$(date +%s)
((restart_streak++))
fail_streak=0
save_state
log "action=restart_done"
